# Required
REPO_ROOT=C:\Users\ksen010\DemoRepo\react_project_Health_Insurance_Claim_Management
ORCHESTRATOR_API_KEY=kjhjgjhjhkn878787678ghj67ygjhh777tgyghafss

# Server
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=4400
# Public URL for approval-summary links in emails (optional)
ORCHESTRATOR_PUBLIC_URL=http://127.0.0.1:4400
# Optional: point at a different .env file so multiple orchestrator instances (one per
# target app) can share this codebase, e.g. $env:ORCHESTRATOR_ENV_FILE='.env.pci'; npm run dev
# ORCHESTRATOR_ENV_FILE=.env
# Optional: override where run state (data/) is stored, useful when sharing a codebase
# across instances via ORCHESTRATOR_ENV_FILE. Relative paths resolve under the orchestrator folder.
# DATA_DIR=data

# Which host owns the git repo's pull requests/tags: "github" (default) or "ado-repos"
GIT_PROVIDER=github

# Git / GitHub (required for Phase 7 PR creation when GIT_PROVIDER=github)
GITHUB_TOKEN=
GITHUB_OWNER=Hishitha-GJ
GITHUB_REPO=react_project_Health_Insurance_Claim_Management
# PAT needs repo scope (push + pull requests). Never auto-merge.
DEFAULT_BASE_BRANCH=dev
# Must exist locally (this repo: dev or master — not main)
ALLOW_DIRTY_REPO=true

# Cursor SDK (Phase 4 agent execution)
CURSOR_API_KEY=crsr_dded1467b75228a14b9b9c61589368190192ba48c76e80ad6f0cb62f77e909ba
CURSOR_MODEL=composer-2.5
CURSOR_DRY_RUN=false

# Validation policy (Phase 5)
STRICT_VALIDATION=false
VALIDATION_TIMEOUT_MS=600000
VALIDATION_SKIP_FRONTEND_BUILD=false
# Optional command overrides (empty = auto-detect from repo)
# VALIDATION_BACKEND_BUILD_CMD=dotnet build --verbosity minimal
# VALIDATION_BACKEND_BUILD_CWD=HealthInsuranceClaimAPI
# VALIDATION_BACKEND_TEST_CMD=dotnet test --no-build --verbosity minimal
# VALIDATION_BACKEND_TEST_CWD=HealthInsuranceClaimAPI
# VALIDATION_FRONTEND_BUILD_CMD=npm run build
# VALIDATION_FRONTEND_BUILD_CWD=healthinsuranceclaim_frontend
# VALIDATION_FRONTEND_TEST_CMD=npm test
# VALIDATION_FRONTEND_TEST_CWD=healthinsuranceclaim_frontend

# Concurrency
REPO_LOCK=true

# Artifacts directory (relative to REPO_ROOT or absolute)
ARTIFACTS_DIR=automation/artifacts

# --- Azure DevOps (PBI + bug intake, comments, state transitions, and — when
# GIT_PROVIDER=ado-repos — pull requests/tags too) ---
# PAT needs Work Items (Read, write & manage) scope, plus Code (Read & Write) and
# Pull Request (Read & Write) when GIT_PROVIDER=ado-repos. Leave blank to disable ADO
# integration (runs still work from chat/email intake; ADO comments/state updates are skipped).
ADO_ORG=your-ado-org
ADO_PROJECT=your-ado-project
# Azure Repos git repository name (only needed when GIT_PROVIDER=ado-repos). Defaults to ADO_PROJECT.
ADO_REPO=your-ado-repo
ADO_PAT=
# States written by the pipeline as a work item moves through gates. Override to match
# your process template (these defaults match the standard Agile/Scrum templates).
ADO_STATE_PLAN_APPROVED=Active
ADO_STATE_IN_REVIEW=In Review
ADO_STATE_RESOLVED=Resolved
ADO_STATE_DONE=Closed

# --- PBI planning gate (Gate 1) ---
# Plans estimating more LOC than this are auto-blocked and require the PBI to be split.
MAX_PLAN_LOC=400

# --- Coverage gate (best-effort; requires repo-side coverage tooling already configured) ---
MIN_FILE_COVERAGE=60

# --- Outbound pipeline events (run.created, plan.awaiting_approval, pr.created, deploy.*, uat.*, ...) ---
# Point this at an n8n webhook to react to state changes without polling GET /runs/:id.
N8N_EVENT_WEBHOOK_URL=
