{
  "name": "bugfix-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Local orchestrator for email-driven bug-fix automation demo",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:pci": "set ORCHESTRATOR_ENV_FILE=.env.pci&& tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-node": "^1.7.0",
    "@cursor/sdk": "^1.0.19",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
