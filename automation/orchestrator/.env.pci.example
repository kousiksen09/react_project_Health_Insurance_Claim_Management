# PCI target app — copy to .env.pci and fill in secrets.
# Run: npm run dev:pci   (or $env:ORCHESTRATOR_ENV_FILE='.env.pci'; npm run dev)

REPO_ROOT=C:\Users\ksen010\DemoRepo\PCI
ORCHESTRATOR_API_KEY=generate-a-random-secret

ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=4401
ORCHESTRATOR_PUBLIC_URL=http://127.0.0.1:4401
DATA_DIR=data-pci

GIT_PROVIDER=ado-repos
DEFAULT_BASE_BRANCH=dev
ALLOW_DIRTY_REPO=false

CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_DRY_RUN=true

STRICT_VALIDATION=false
VALIDATION_TIMEOUT_MS=600000
VALIDATION_SKIP_FRONTEND_BUILD=false
VALIDATION_BACKEND_BUILD_CMD=dotnet build PwC.PCI.sln --verbosity minimal
VALIDATION_BACKEND_BUILD_CWD=.
VALIDATION_FRONTEND_BUILD_CMD=npm run build:dev
VALIDATION_FRONTEND_BUILD_CWD=PwC.PCI.ClientApp

REPO_LOCK=true
ARTIFACTS_DIR=automation/orchestrator/artifacts-pci

ADO_ORG=pwc-us-fmre
ADO_PROJECT=Private Capital Intelligence
ADO_REPO=PCI
ADO_PAT=
ADO_STATE_PLAN_APPROVED=Active
ADO_STATE_IN_REVIEW=In Review
ADO_STATE_RESOLVED=Resolved
ADO_STATE_DONE=Closed

MAX_PLAN_LOC=400
MIN_FILE_COVERAGE=60
N8N_EVENT_WEBHOOK_URL=
